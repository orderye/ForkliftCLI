# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forklift_bao

# Redis
# 免费版"每日 3 次/功能"的额度门禁依赖它。Redis 不可用时门禁 fail-open（放行并记
# warning 日志），不会把付费功能一起打挂；启动日志和 GET /health 的 dependencies
# 字段都能看到当前状态。
# docker-compose 起 redis 服务后这里用 redis://redis:6379/0。
REDIS_URL=redis://localhost:6379/0

# JWT密钥（生产环境必须修改）
SECRET_KEY=your-secret-key-change-in-production

# AI配置
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 向量数据库
QDRANT_URL=http://localhost:6333
WEMM_MODEL_NAME=tencent/WeMM-Embedding-2B
WEMM_EMBED_DIM=1024

# OCR
OCR_PROVIDER=paddleocr
